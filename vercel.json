{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "functions": {
    "api/server.cjs": {
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    { "source": "/((?!assets/|img/|api/|favicon\\.svg|robots\\.txt|sitemap\\.xml).*)", "destination": "/api/server" }
  ]
}
